# Copy to .env and fill in. Never commit real values.

# Optional Stack Exchange app key (raises the daily quota from 300 to 10,000 requests).
# Register at https://stackapps.com/apps/oauth/register. Keys are not secret, but keep them out of git anyway.
STACKEXCHANGE_KEY=

# Root directory for raw/processed data and artifacts.
AII_DATA_DIR=./data

# PostgreSQL (used by the API from Milestone 7).
POSTGRES_USER=aii
POSTGRES_PASSWORD=change-me
POSTGRES_DB=aii
DATABASE_URL=postgresql+psycopg://aii:change-me@localhost:5432/aii
